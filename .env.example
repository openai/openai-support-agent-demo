# openai (default)
AI_PROVIDER=openai
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-5.2

# openrouter (set AI_PROVIDER=openrouter to use these values)
# OPENROUTER_API_KEY=<your-openrouter-api-key>
# OPENROUTER_MODEL=openai/gpt-5.2
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Required for OpenAI-managed Vector Store/file_search, even when inference
# uses OpenRouter. OPENAI_API_KEY is also accepted as a fallback.
# OPENAI_VECTOR_STORE_API_KEY=<your-openai-api-key>
