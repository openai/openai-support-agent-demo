    "test": "cross-env TS_NODE_COMPILER_OPTIONS=\"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" node -r ts-node/register/transpile-only -r ./scripts/register-tsconfig-paths.js --test",
